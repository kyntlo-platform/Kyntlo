Options -MultiViews
DirectoryIndex index.html

RewriteEngine On

# Redirect public .html URLs to clean URLs.
RewriteCond %{THE_REQUEST} \s/+(.+?)\.html[\s?] [NC]
RewriteRule ^ %1 [R=301,L]

# Serve clean URLs from matching .html files.
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+?)/?$ $1.html [L]

# ---------------------------------------------------------------------------
# Caching
#
# HTML is revalidated on every request, so a deploy is visible immediately.
# CSS/JS/images carry a ?v= stamp (bump VERSION in the page <head> links on each
# deploy), so they can be cached hard - a new version is simply a new URL.
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, must-revalidate, max-age=0"
    </FilesMatch>

    <FilesMatch "\.(css|js|png|jpe?g|webp|gif|svg|ico|woff2?)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # Baseline security headers
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/html "access plus 0 seconds"
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
</IfModule>

# ---------------------------------------------------------------------------
# Keep source-of-truth documents out of the public site.
#
# docs/ holds the product decision register and the white-label BRD, scripts/
# holds the build check, and the changelog records internal history. All three
# live in the repository but must never be reachable over HTTP.
# ---------------------------------------------------------------------------
RedirectMatch 404 ^/(docs|scripts)(/|$)

<FilesMatch "\.(md|ps1|sh|yml|yaml|json|lock)$">
    Require all denied
</FilesMatch>

# ---------------------------------------------------------------------------
# Content-Security-Policy, in REPORT-ONLY mode.
#
# Nothing is blocked while this header is Report-Only - the browser only logs
# what *would* have been blocked, to the console and to report-uri if one is set.
# Watch the console on a real deploy for a few days, especially through a full
# checkout, a contact-form submit and a demo booking, since the Whop, Forminit
# and LeadConnector loaders each pull further resources of their own that cannot
# be enumerated from this repository. Once the report is quiet, rename the header
# to Content-Security-Policy to start enforcing it.
#
# 'unsafe-inline' is required for both scripts and styles: every page carries its
# own inline <style>, and thirteen carry an inline <script>. Removing it means
# extracting those to files or hashing them, which is a larger change.
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set Content-Security-Policy-Report-Only "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; form-action 'self' https://forminit.com; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://js.whop.com https://forminit.com https://links.kyntlo.ai https://widgets.leadconnectorhq.com https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdn.jsdelivr.net; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https:; media-src 'self'; frame-src https://js.whop.com https://links.kyntlo.ai https://widgets.leadconnectorhq.com https://services.leadconnectorhq.com; connect-src 'self' https://www.google-analytics.com https://analytics.google.com https://*.analytics.google.com https://www.googletagmanager.com https://js.whop.com https://forminit.com https://links.kyntlo.ai https://widgets.leadconnectorhq.com https://services.leadconnectorhq.com; upgrade-insecure-requests"
</IfModule>
